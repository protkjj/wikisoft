# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# WIKISOFT4 백엔드 연결
# 봇의 /check, /recent 가 조회하는 검증 서버 주소
WIKISOFT4_API_URL=http://127.0.0.1:8004
# 인증 (선택) — 공개 경로만 쓰면 없어도 동작한다
# WIKISOFT4_API_KEY=wk4_xxxxxxxx
# WIKISOFT4_API_TOKEN=eyJhbGciOi...
# 요청 타임아웃 (초, 기본 10)
WIKISOFT4_API_TIMEOUT=10

# AI API (선택)
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
